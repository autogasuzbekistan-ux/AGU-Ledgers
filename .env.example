BOT_TOKEN=your_telegram_bot_token
GOOGLE_SHEETS_ID=your_sheet_id
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service_account.json
# Bir yoki bir nechta Telegram ID, vergul bilan ajratilgan (9-bo'lim)
ALLOWED_TELEGRAM_ID=your_telegram_user_id

# --- Ixtiyoriy sozlamalar (standart qiymatlar bilan) ---
# Kontragentlar ro'yxati va nom-alias jadvali shu JSON faylda saqlanadi
ALIASES_JSON_PATH=aliases_data.json
AUDIT_LOG_PATH=audit.log
# Oylik komissiya stavkasi (3-bo'lim: standart 1%, qattiq kodlanmagan)
COMMISSION_RATE=0.01
# G'ayrioddiy katta summa - qo'shimcha tasdiq so'raladi (9-bo'lim)
LARGE_AMOUNT_THRESHOLD_USD=5000
# Qarz shu chegaradan oshsa - bildirishnoma (8-bo'lim)
DEBT_ALERT_THRESHOLD_USD=10000
# Necha kun to'lovsiz qolsa - bildirishnoma (8-bo'lim)
NO_PAYMENT_ALERT_DAYS=3
# Har kuni ertalab qarzdorlar ro'yxati shu soatda yuboriladi (8-bo'lim)
MORNING_DIGEST_HOUR=8
